      },
      "id": 1,
      "title": "Total Tokens by Provider (24h Window)",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(increase(codelens_llm_tokens_total[24h])) by (provider)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Tokens by Type (Prompt vs Completion)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(codelens_llm_tokens_total[5m])) by (token_type)",
          "legendFormat": "{{token_type}} tokens/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Estimated LLM Cost (USD / 24h)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(increase(codelens_llm_tokens_total{provider=\"openai\"}[24h])) * 5 / 1000000) + (sum(increase(codelens_llm_tokens_total{provider=\"anthropic\"}[24h])) * 3 / 1000000) + (sum(increase(codelens_llm_tokens_total{provider=\"gemini\"}[24h])) * 1.5 / 1000000) or vector(0)",
          "legendFormat": "Est. 24h Spend ($)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    }
  ],
