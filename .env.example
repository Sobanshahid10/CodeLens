# Database (PostgreSQL + pgvector)
POSTGRES_DB=codelens
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://codelens:codelens_password_change_me@postgres:5432/codelens
APP_DATABASE_URL=postgresql://codelens_app:changeme_in_env@postgres:5432/codelens

# Redis & Celery
REDIS_PASSWORD=redis_password_change_me
REDIS_URL=redis://:redis_password_change_me@redis:6379/0
CELERY_BROKER_URL=redis://:redis_password_change_me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password_change_me@redis:6379/0

# Qdrant Vector Database
QDRANT_API_KEY=qdrant_api_key_change_me_12345
QDRANT_URL=http://qdrant:6333

# Grafana Monitoring
GRAFANA_PASSWORD=admin_password_change_me

# Application & Auth
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
ENVIRONMENT=development
LOG_LEVEL=INFO
